{
  "name": "node-ts",
  "description": "Node and TypeScript web apps and API services, with lint, types, unit tests, and Playwright.",
  "verify": {
    "fast": ["npm run lint", "npm run typecheck", "npm run test:unit"],
    "full": ["npm run lint", "npm run typecheck", "npm run test:unit", "npm run test:e2e"],
    "e2e": "npm run test:e2e"
  },
  "t2Paths": ["eslint.config.*", "tsconfig*.json", "playwright.config.*", ".npmrc"],
  "licenseExceptions": ["minimatch"],
  "gitignore": ["/dist/", "/test-results/", "/playwright-report/"],
  "formatters": {
    ".ts": "npx prettier --write",
    ".tsx": "npx prettier --write",
    ".js": "npx prettier --write",
    ".mjs": "npx prettier --write",
    ".json": "npx prettier --write",
    ".css": "npx prettier --write",
    ".html": "npx prettier --write"
  },
  "ci": {
    "setup": [
      {
        "name": "Install dependencies and browser",
        "run": "npm ci --ignore-scripts && npx playwright install --with-deps chromium"
      }
    ]
  }
}
