{
  "name": "desktop-mobile",
  "extends": "browser-game",
  "description": "Tauri desktop apps for Windows and macOS, with a path to Android and iOS. See docs/MOBILE.md.",
  "verify": {
    "fast": [
      "cargo fmt --check --manifest-path src-tauri/Cargo.toml",
      "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
      "cargo test --manifest-path src-tauri/Cargo.toml"
    ],
    "full": [
      "cargo fmt --check --manifest-path src-tauri/Cargo.toml",
      "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
      "cargo test --manifest-path src-tauri/Cargo.toml",
      "cargo deny --manifest-path src-tauri/Cargo.toml check licenses bans sources",
      "node --test \"tests-node/*.test.mjs\"",
      "node shared/test-harness/run.mjs . --milestone ci",
      "cargo tauri build --debug --no-bundle"
    ],
    "e2e": ["cargo tauri build --debug --no-bundle", "node shared/test-harness/run.mjs . --milestone e2e --slow"]
  },
  "t2Paths": ["src-tauri/capabilities/**", "src-tauri/tauri.conf.json", "src-tauri/deny.toml", "src-tauri/Info.plist"],
  "gitignore": ["/src-tauri/target/", "/src-tauri/gen/schemas/"],
  "formatters": { ".rs": "rustfmt --edition 2024" },
  "ci": {
    "setup": [
      {
        "name": "Install Rust",
        "uses": "dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec",
        "with": { "components": "clippy, rustfmt" }
      },
      {
        "name": "Install Rust tools",
        "uses": "taiki-e/install-action@3a3daafd3b7f23b8f65d9f5ba2db203fb59b79e2",
        "with": { "tool": "cargo-deny,tauri-cli" }
      },
      {
        "name": "Install the test harness and browser",
        "run": "cd shared/test-harness && npm ci --ignore-scripts && npx playwright install --with-deps chromium"
      }
    ]
  }
}
