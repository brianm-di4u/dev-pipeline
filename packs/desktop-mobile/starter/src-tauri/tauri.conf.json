{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{SLUG}}",
  "version": "0.1.0",
  "identifier": "com.example.{{SLUG}}",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "{{PROJECT}}", "width": 1024, "height": 720 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
